                this.feedbackBox = document.getElementById('feedback-box');
                this.cluesContainer = document.getElementById('clues-container');
                this.clueProgressText = document.getElementById('clue-progress-text');
                this.suspectStatusTitle = document.getElementById('suspect-status-title');
                this.suspectStatusDesc = document.getElementById('suspect-status-desc');
                this.suspectSilhouette = document.getElementById('suspect-silhouette');
                this.virtualKeypad = document.getElementById('virtual-keypad');

                this.bindEvents();
            }

            init() {
                this.currentCaseIndex = 0;
                this.score = 0;
                
                if (this.difficulty === 'EASY') this.timeLeft = 240;
                else if (this.difficulty === 'MEDIUM') this.timeLeft = 180;
                else this.timeLeft = 150;

                this.unlockedClues = [];
                this.totalAttempts = 0;
                this.wrongAttempts = 0;

                this.cases = [];
                for (let i = 0; i < this.casesCount; i++) {
                    this.cases.push(generateEquation(i, this.difficulty));
                }

                this.renderClueCards();
                this.loadCase(0);
                this.updateScore(0);
                this.startTimer();

                document.getElementById('victory-modal').classList.add('hidden');
                document.getElementById('gameover-modal').classList.add('hidden');
                document.getElementById('confetti-canvas').classList.add('hidden');
            }

            bindEvents() {
                // Name Submit Form
                document.getElementById('name-form').addEventListener('submit', (e) => {
                    e.preventDefault();
                    soundFX.playClick();
                    const val = document.getElementById('player-name-input').value.trim();
                    if (val) {
                        this.playerName = val;
                        localStorage.setItem('last_detective_name', val);
                    }
                    
                    const diffEl = document.querySelector('input[name="difficulty"]:checked');
                    if (diffEl) this.difficulty = diffEl.value;

                    this.headerDetectiveName.textContent = this.playerName;
                    
                    let diffLabel = '初級';
                    if (this.difficulty === 'MEDIUM') diffLabel = '中級';
                    if (this.difficulty === 'HARD') diffLabel = '高級';
                    this.headerDiffBadge.textContent = diffLabel;

                    document.getElementById('name-modal').classList.add('hidden');
                    this.init();
                });

                // Virtual Keypad Button handling
                this.virtualKeypad.addEventListener('click', (e) => {
                    const btn = e.target.closest('button[data-key]');
                    if (!btn) return;
                    soundFX.playClick();

                    const key = btn.getAttribute('data-key');
                    let currentVal = this.answerInput.value;

                    if (key === 'BACK') {
                        this.answerInput.value = currentVal.slice(0, -1);
                    } else if (key === 'CLEAR') {
                        this.answerInput.value = '';
                    } else if (key === 'MINUS') {
                        if (currentVal.startsWith('-')) {
                            this.answerInput.value = currentVal.substring(1);
                        } else {
                            this.answerInput.value = '-' + currentVal;
                        }
                    } else if (key !== 'SUBMIT') {
                        if (currentVal.length < 8) {
                            this.answerInput.value += key;
                        }
                    }
                });

                // Clear input button
                document.getElementById('clear-input-btn').addEventListener('click', () => {
                    soundFX.playClick();
                    this.answerInput.value = '';
                });

                // Keypad Toggle Mode (Virtual Numpad vs OS Keyboard)
                document.getElementById('toggle-keypad-btn').addEventListener('click', () => {
                    soundFX.playClick();
                    const isReadOnly = this.answerInput.hasAttribute('readonly');
                    if (isReadOnly) {
                        this.answerInput.removeAttribute('readonly');
                        this.virtualKeypad.classList.add('hidden');
                        document.getElementById('keypad-toggle-text').textContent = '顯示軟鍵盤';
                        this.answerInput.focus();
                    } else {
                        this.answerInput.setAttribute('readonly', 'true');
                        this.virtualKeypad.classList.remove('hidden');
                        document.getElementById('keypad-toggle-text').textContent = '按鈕鍵盤';
                    }
                });

                // Answer Form Submit
                document.getElementById('answer-form').addEventListener('submit', (e) => {
                    e.preventDefault();
                    this.checkAnswer();
                });

                // Physical Keyboard Support
                window.addEventListener('keydown', (e) => {
                    if (document.getElementById('name-modal').classList.contains('hidden') && 
                        document.getElementById('victory-modal').classList.contains('hidden')) {
                        if (e.key === 'Enter') {
                            this.checkAnswer();
                        }
                    }
                });

                // Leaderboard Modals
                const openLb = () => {
                    soundFX.playClick();
                    this.leaderboard.renderTable();
                    document.getElementById('leaderboard-modal').classList.remove('hidden');
                };
                const closeLb = () => {
                    soundFX.playClick();
                    document.getElementById('leaderboard-modal').classList.add('hidden');
                };

                document.getElementById('open-leaderboard-btn').addEventListener('click', openLb);
                document.getElementById('welcome-leaderboard-btn').addEventListener('click', openLb);
                document.getElementById('victory-leaderboard-btn').addEventListener('click', openLb);
                document.getElementById('close-leaderboard-btn').addEventListener('click', closeLb);
                document.getElementById('close-leaderboard-bottom-btn').addEventListener('click', closeLb);

                document.getElementById('clear-leaderboard-btn').addEventListener('click', () => {
                    soundFX.playClick();
                    this.leaderboard.clear();
                    this.leaderboard.renderTable();
                });

                // Mute Sound Button
                document.getElementById('sound-btn').addEventListener('click', () => {
                    soundFX.muted = !soundFX.muted;
                    document.getElementById('sound-icon-on').classList.toggle('hidden', soundFX.muted);
                    document.getElementById('sound-icon-off').classList.toggle('hidden', !soundFX.muted);
                });

                // Restarts
                document.getElementById('restart-btn').addEventListener('click', () => {
                    soundFX.playClick();
                    this.init();
                });
                document.getElementById('victory-restart-btn').addEventListener('click', () => {
                    soundFX.playClick();
                    this.init();
                });
                document.getElementById('gameover-restart-btn').addEventListener('click', () => {
                    soundFX.playClick();
                    this.init();
                });

                // Restore previous player name
                const lastName = localStorage.getItem('last_detective_name');
                if (lastName) {
                    document.getElementById('player-name-input').value = lastName;
                }
            }

            startTimer() {
                clearInterval(this.timerInterval);
                this.updateTimerDisplay();

                this.timerInterval = setInterval(() => {
                    this.timeLeft--;
                    this.updateTimerDisplay();

                    if (this.timeLeft <= 0) {
                        clearInterval(this.timerInterval);
                        this.triggerGameOver();
                    }
                }, 1000);
            }

            updateTimerDisplay() {
                const mins = Math.floor(this.timeLeft / 60);
                const secs = this.timeLeft % 60;
                this.timerDisplay.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

                if (this.timeLeft <= 25) {
                    this.timerBox.classList.remove('border-slate-800');
                    this.timerBox.classList.add('border-red-500/80', 'bg-red-950/40', 'animate-pulse');
                    this.timerDisplay.classList.remove('text-cyan-400');
                    this.timerDisplay.classList.add('text-red-400');
                } else {
                    this.timerBox.classList.add('border-slate-800');
                    this.timerBox.classList.remove('border-red-500/80', 'bg-red-950/40', 'animate-pulse');
                    this.timerDisplay.classList.add('text-cyan-400');
                    this.timerDisplay.classList.remove('text-red-400');
                }
            }

            updateScore(delta) {
                this.score += delta;
                if (this.score < 0) this.score = 0;
                this.scoreDisplay.textContent = this.score.toString().padStart(4, '0');
            }

            loadCase(index) {
                this.currentCaseIndex = index;
                const curr = this.cases[index];

                this.caseNumberBadge.textContent = `CASE #0${index + 1} / 05`;
                this.caseTitleText.textContent = curr.title;
                this.caseDescription.textContent = curr.desc;
                this.equationDisplay.textContent = curr.displayStr;

                this.answerInput.value = '';
                this.feedbackBox.classList.add('hidden');
            }

            checkAnswer() {
                const valStr = this.answerInput.value.trim();
                if (!valStr) return;

                const userVal = parseFloat(valStr);
                if (isNaN(userVal)) return;

                const currentCase = this.cases[this.currentCaseIndex];
                this.totalAttempts++;

                if (Math.abs(userVal - currentCase.x) < 0.001) {
                    soundFX.playCorrect();
                    this.handleCorrectAnswer(currentCase);
                } else {
                    soundFX.playWrong();
                    this.wrongAttempts++;
                    this.handleWrongAnswer(currentCase, userVal);
                }
            }

            handleCorrectAnswer(currentCase) {
                let basePoints = 200;
                if (this.difficulty === 'MEDIUM') basePoints = 300;
                if (this.difficulty === 'HARD') basePoints = 450;

                const pts = basePoints + Math.min(50, this.timeLeft);
                this.updateScore(pts);

                this.unlockedClues.push({
                    index: this.currentCaseIndex,
                    name: currentCase.clueName,
                    text: currentCase.clueText
                });

                this.updateClueBoard();

                this.feedbackBox.className = "mt-3 p-3 rounded-xl border border-emerald-500/50 bg-emerald-950/40 text-emerald-300 text-xs sm:text-sm block shadow-lg";
                this.feedbackBox.innerHTML = `
                    <div class="flex items-center gap-1.5 font-bold text-emerald-400 mb-0.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                        破解成功！解答正確 (x = ${currentCase.x})
                    </div>
                    <p class="text-xs text-emerald-200/80">獲得情報：<span class="font-semibold text-amber-300">【${currentCase.clueName}】${currentCase.clueText}</span> (+${pts} 分)</p>
                `;

                setTimeout(() => {
                    if (this.currentCaseIndex + 1 < this.casesCount) {
                        this.loadCase(this.currentCaseIndex + 1);
                    } else {
                        this.triggerVictory();
                    }
                }, 1600);
            }

            handleWrongAnswer(currentCase, userVal) {
                this.updateScore(-30);

                const card = this.answerInput.closest('.bg-slate-900\\/95');
                if (card) {
                    card.classList.add('animate-shake');
                    setTimeout(() => card.classList.remove('animate-shake'), 400);
                }

                const { a, b, c, x } = currentCase;
                const bOp = b > 0 ? `減去 ${b}` : `加上 ${Math.abs(b)}`;
                const step1Right = c - b;
                const step1Str = `${a}x = ${c} ${b > 0 ? '-' : '+'} ${Math.abs(b)}  ⇒  ${a}x = ${step1Right}`;
                const step2Str = `x = ${step1Right} ÷ (${a})  ⇒  x = ${x}`;

                this.feedbackBox.className = "mt-3 p-3 rounded-xl border border-red-500/50 bg-red-950/40 text-red-200 text-xs sm:text-sm block shadow-lg";
                this.feedbackBox.innerHTML = `
                    <div class="text-red-400 font-bold mb-1.5 flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        計算有誤！x = ${userVal} 不符合方程式 (-30分)
                    </div>
                    <div class="bg-slate-950/80 p-2.5 rounded-lg border border-red-500/30 text-[11px] sm:text-xs space-y-1 font-mono">
                        <p class="text-amber-400 font-sans font-semibold">🔍 逐步移項解析：</p>
                        <p>原式：<span class="text-cyan-300">${currentCase.displayStr}</span></p>
                        <p>步驟 1 (移項)：兩邊同${bOp} → <span class="text-slate-200">${step1Str}</span></p>
                        <p>步驟 2 (求解)：兩邊同除以係數 (${a}) → <span class="text-emerald-400 font-bold">${step2Str}</span></p>
                    </div>
                `;
            }

            renderClueCards() {
                this.cluesContainer.innerHTML = '';
                for (let i = 0; i < this.casesCount; i++) {
                    const card = document.createElement('div');
                    card.id = `clue-card-${i}`;
                    card.className = "detective-pin bg-slate-950 border border-slate-800 p-3 rounded-xl transition-all opacity-60";
                    card.innerHTML = `
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-[10px] font-mono text-slate-500">線索卡 #0${i + 1}</span>
                            <span class="stamp-classified text-[9px]">LOCKED</span>
                        </div>
                        <div class="text-xs font-semibold text-slate-400">???</div>
                        <div class="text-[10px] text-slate-600 mt-0.5">破解 CASE #0${i + 1} 以解鎖...</div>
                    `;
                    this.cluesContainer.appendChild(card);
                }
            }

            updateClueBoard() {
                const count = this.unlockedClues.length;
                this.clueProgressText.textContent = `${count} / ${this.casesCount} 線索`;

                this.unlockedClues.forEach(clue => {
                    const card = document.getElementById(`clue-card-${clue.index}`);
                    if (card && !card.classList.contains('unlocked')) {
                        card.classList.add('unlocked');
                        card.className = "detective-pin bg-slate-950 border border-amber-500/40 p-3 rounded-xl transition-all shadow-md shadow-amber-500/5 glow-gold";
                        card.innerHTML = `
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-[10px] font-mono text-amber-400 font-semibold">情報 #0${clue.index + 1}</span>
                                <span class="stamp-solved text-[9px]">SOLVED</span>
                            </div>
                            <div class="text-xs font-bold text-amber-300">${clue.name}</div>
                            <div class="text-[11px] text-slate-200 mt-1 font-mono bg-slate-900 p-2 rounded border border-slate-800">${clue.text}</div>
                        `;
                    }
                });

                const percent = (count / this.casesCount) * 100;
                this.suspectStatusTitle.textContent = `嫌犯鎖定進度: ${percent}%`;

                if (count === 5) {
                    this.suspectStatusDesc.textContent = "🎯 身分完全鎖定！成功逮捕『千面狐』";
                    this.suspectSilhouette.textContent = "🚨";
                } else if (count >= 3) {
                    this.suspectStatusDesc.textContent = "接近主腦身分！還原犯罪脈絡";
                    this.suspectSilhouette.textContent = "👤";
                } else if (count >= 1) {
                    this.suspectStatusDesc.textContent = "已獲得外貌與作案時間線索";
                    this.suspectSilhouette.textContent = "🔍";
                }
            }

            triggerVictory() {
                clearInterval(this.timerInterval);
                soundFX.playVictory();

                let maxTime = 180;
                if (this.difficulty === 'EASY') maxTime = 240;
                if (this.difficulty === 'HARD') maxTime = 150;

                const timeUsed = maxTime - this.timeLeft;
                const accuracy = Math.round(((this.casesCount) / (this.totalAttempts || 1)) * 100);

                let rank = "見習偵探";
                if (this.score >= 1200 && accuracy >= 80) rank = "👑 首席數學神探";
                else if (this.score >= 850) rank = "🕵️ 資深密碼偵探";
                else rank = "👮 警署巡警助手";

                document.getElementById('victory-player-name').textContent = this.playerName;
                document.getElementById('final-rank').textContent = rank;
                document.getElementById('final-score').textContent = this.score;

                const mins = Math.floor(this.timeLeft / 60);
                const secs = this.timeLeft % 60;
                document.getElementById('final-time').textContent = `${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`;
                document.getElementById('final-accuracy').textContent = `${accuracy}%`;

                this.leaderboard.addRecord(this.playerName, this.score, timeUsed, accuracy, this.difficulty);

                document.getElementById('victory-modal').classList.remove('hidden');
                startConfetti();
            }

            triggerGameOver() {
                soundFX.playWrong();
                document.getElementById('gameover-modal').classList.remove('hidden');
            }
        }

        function startConfetti() {
            const canvas = document.getElementById('confetti-canvas');
            canvas.classList.remove('hidden');
            const ctx = canvas.getContext('2d');

            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const particles = [];
            const colors = ['#f59e0b', '#06b6d4', '#10b981', '#ec4899', '#3b82f6'];

            for (let i = 0; i < 110; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height - canvas.height,
                    size: Math.random() * 8 + 4,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    vx: Math.random() * 4 - 2,
                    vy: Math.random() * 4 + 3,
                    rotation: Math.random() * 360,
                    vRot: Math.random() * 6 - 3
                });
            }

            let animationFrame;
            function render() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let alive = false;

                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    p.rotation += p.vRot;

                    if (p.y < canvas.height) alive = true;

                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate((p.rotation * Math.PI) / 180);
                    ctx.fillStyle = p.color;
                    ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
                    ctx.restore();
                });

                if (alive) animationFrame = requestAnimationFrame(render);
            }

            render();

            setTimeout(() => {
                cancelAnimationFrame(animationFrame);
                canvas.classList.add('hidden');
            }, 4500);
        }

        /* App Startup Initialization */
        window.addEventListener('DOMContentLoaded', () => {
            window.gameInstance = new GameEngine();
        });
    </script>
</body>
