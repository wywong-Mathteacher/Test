    <script>
        class SoundEngine {
            constructor() {
                this.ctx = null;
                this.muted = false;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) this.ctx = new AudioCtx();
                }
            }

            playClick() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;

                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(550, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(750, this.ctx.currentTime + 0.04);

                gain.gain.setValueAtTime(0.1, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.04);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.04);
            }

            playCorrect() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;

                const notes = [523.25, 659.25, 783.99, 1046.50];
                notes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.value = freq;

                    const startTime = this.ctx.currentTime + (idx * 0.07);
                    gain.gain.setValueAtTime(0.15, startTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.22);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(startTime);
                    osc.stop(startTime + 0.22);
                });
            }

            playWrong() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;

                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(160, this.ctx.currentTime);
                osc.frequency.linearRampToValueAtTime(100, this.ctx.currentTime + 0.22);

                gain.gain.setValueAtTime(0.18, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.22);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.22);
            }

            playVictory() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;

                const arpeggio = [440, 554.37, 659.25, 880, 659.25, 880];
                arpeggio.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.value = freq;

                    const startTime = this.ctx.currentTime + (idx * 0.1);
                    gain.gain.setValueAtTime(0.18, startTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.3);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(startTime);
                    osc.stop(startTime + 0.3);
                });
            }
        }

        const soundFX = new SoundEngine();

        class LeaderboardManager {
            constructor() {
                this.STORAGE_KEY = 'detective_math_leaderboard_v2';
            }

            getRecords() {
                try {
                    const data = localStorage.getItem(this.STORAGE_KEY);
                    return data ? JSON.parse(data) : [];
                } catch(e) {
                    return [];
                }
            }

            addRecord(name, score, timeUsed, accuracy, diff) {
                const records = this.getRecords();
                const now = new Date();
                const dateStr = `${now.getMonth()+1}/${now.getDate()}`;

                records.push({
                    name: name || '無名神探',
                    score: score,
                    timeUsed: timeUsed,
                    accuracy: accuracy,
                    diff: diff || 'EASY',
                    date: dateStr
                });

                records.sort((a, b) => b.score - a.score || a.timeUsed - b.timeUsed);
                const top10 = records.slice(0, 10);
                try {
                    localStorage.setItem(this.STORAGE_KEY, JSON.stringify(top10));
                } catch(e) {}
                return top10;
            }

            clear() {
                try {
                    localStorage.removeItem(this.STORAGE_KEY);
                } catch(e) {}
            }

            renderTable() {
                const tbody = document.getElementById('leaderboard-tbody');
                const records = this.getRecords();

                if (records.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="p-5 text-center text-slate-500 font-sans">尚無榜單紀錄，快來完成通關！</td>
                        </tr>
                    `;
                    return;
                }

                tbody.innerHTML = records.map((rec, idx) => {
                    let rankBadge = `${idx + 1}`;
                    if (idx === 0) rankBadge = '🥇';
                    else if (idx === 1) rankBadge = '🥈';
                    else if (idx === 2) rankBadge = '🥉';

                    const mins = Math.floor(rec.timeUsed / 60);
                    const secs = rec.timeUsed % 60;
                    const timeStr = `${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`;

                    let diffLabel = '初級';
                    if (rec.diff === 'MEDIUM') diffLabel = '中級';
                    if (rec.diff === 'HARD') diffLabel = '高級';

                    return `
                        <tr class="hover:bg-slate-900 transition-colors">
                            <td class="p-2.5 text-center font-bold text-amber-400">${rankBadge}</td>
                            <td class="p-2.5 font-sans font-semibold text-slate-200">${escapeHtml(rec.name)}</td>
                            <td class="p-2.5 text-center"><span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-amber-300 border border-slate-700">${diffLabel}</span></td>
                            <td class="p-2.5 text-right font-bold text-cyan-400">${rec.score}</td>
                            <td class="p-2.5 text-center text-slate-300">${timeStr}</td>
                            <td class="p-2.5 text-center text-emerald-400">${rec.accuracy}%</td>
                        </tr>
                    `;
                }).join('');
            }
        }

        function escapeHtml(str) {
            return str.replace(/[&<>"']/g, (m) => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[m]);
        }

        const CASE_SCENARIOS = [
            {
                title: "第一案：莊園密室保險箱",
                desc: "黑幫保險箱留下代數鎖盤。請解出 x 的數值，解鎖第一塊嫌犯特徵！",
                clueName: "嫌犯外貌特徵",
                clueTemplate: (x) => `身高約 178cm，配戴金邊眼鏡 (解碼: ${x})`
            },
            {
                title: "第二案：加密無線電波號碼",
                desc: "截獲秘密通訊波段。計算未知數 x 即可鎖定嫌犯倉庫據點！",
                clueName: "犯罪據點位置",
                clueTemplate: (x) => `舊城區第 ${Math.abs(x) * 3 + 5} 號廢棄碼頭貨櫃倉庫`
            },
            {
                title: "第三案：監視器時間軸截圖",
                desc: "監視畫面時間碼被竄改。求解方程式能精準還原案發時刻！",
                clueName: "案發現場時間",
                clueTemplate: (x) => `深夜 23:${Math.min(59, Math.abs(x * 4) + 10).toString().padStart(2, '0')} 出現於走廊`
            },
            {
                title: "第四案：黑市轉帳硬碟檔案",
                desc: "攔截異常鉅款轉帳。求解 x 即可取得加密隨身碟動機線索！",
                clueName: "犯罪動機遺留物",
                clueTemplate: (x) => `遺留加密硬碟，爭奪金額 $${Math.abs(x) * 1200 + 15000}`
            },
            {
                title: "第五案：幕後主腦身分解碼",
                desc: "最後一道防火牆！解開最終方程式指引我們逮捕罪魁禍首！",
                clueName: "幕後主腦代號",
                clueTemplate: (x) => `代號『千面狐』— 前皇家密碼局高級工程師`
            }
        ];

        function generateEquation(index, difficulty) {
            let x = 0;
            let a = 1;
            let b = 0;

            if (difficulty === 'EASY') {
                x = Math.floor(Math.random() * 10) + 1; // 1 to 10
                a = Math.floor(Math.random() * 5) + 1;  // 1 to 5
                b = Math.floor(Math.random() * 15) + 1; // 1 to 15
            } else if (difficulty === 'MEDIUM') {
                while (x === 0) x = Math.floor(Math.random() * 21) - 10; // -10 to 10
                while (a === 0) a = Math.floor(Math.random() * 13) - 6;   // -6 to 6
                while (b === 0) b = Math.floor(Math.random() * 31) - 15;  // -15 to 15
            } else { // HARD
                while (x === 0) x = Math.floor(Math.random() * 31) - 15;  // -15 to 15
                while (a === 0 || a === 1 || a === -1) a = Math.floor(Math.random() * 21) - 10;
                while (b === 0) b = Math.floor(Math.random() * 51) - 25;  // -25 to 25
            }

            const c = a * x + b;

            let aStr = '';
            if (a === 1) aStr = 'x';
            else if (a === -1) aStr = '-x';
            else aStr = `${a}x`;

            let bStr = '';
            if (b > 0) bStr = `+ ${b}`;
            else bStr = `- ${Math.abs(b)}`;

            const displayStr = `${aStr} ${bStr} = ${c}`;
            const scenario = CASE_SCENARIOS[index % CASE_SCENARIOS.length];

            return {
                a: a,
                b: b,
                c: c,
                x: x,
                displayStr: displayStr,
                title: scenario.title,
                desc: scenario.desc,
                clueName: scenario.clueName,
                clueText: scenario.clueTemplate(x)
            };
        }

