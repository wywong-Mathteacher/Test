<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>中學一元一次方程式破案冒險 — 跨平台全能版</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Noto+Sans+TC:wght@400;600;700;900&family=JetBrains+Mono:wght@600;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --sat: env(safe-area-inset-top, 0px);
            --sab: env(safe-area-inset-bottom, 0px);
            --sal: env(safe-area-inset-left, 0px);
            --sar: env(safe-area-inset-right, 0px);
        }

        body {
            font-family: 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #0b0e14;
            background-image: 
                radial-gradient(circle at 50% 20%, rgba(245, 158, 11, 0.08) 0%, transparent 60%),
                radial-gradient(circle at 80% 80%, rgba(6, 182, 212, 0.06) 0%, transparent 60%),
                repeating-linear-gradient(45deg, rgba(15, 23, 42, 0.5) 0px, rgba(15, 23, 42, 0.5) 2px, transparent 2px, transparent 8px);
            background-attachment: fixed;
            padding-top: var(--sat);
            padding-bottom: var(--sab);
            padding-left: var(--sal);
            padding-right: var(--sar);
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        .font-tech { font-family: 'Chakra Petch', sans-serif; }
        .font-mono-math { font-family: 'JetBrains Mono', monospace; }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }

        /* Pushpin Effect */
        .detective-pin::before {
            content: '';
            position: absolute;
            top: -6px;
            left: 50%;
            transform: translateX(-50%);
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #f87171, #dc2626, #991b1b);
            box-shadow: 0 2px 5px rgba(0,0,0,0.8);
            z-index: 20;
        }

        /* Red Rubber Stamp Effect */
        .stamp-solved {
            border: 2.5px solid #10b981;
            color: #10b981;
            text-transform: uppercase;
            font-weight: 900;
            padding: 2px 6px;
            border-radius: 4px;
            transform: rotate(-10deg);
            display: inline-block;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.2);
            animation: stamp-pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes stamp-pop {
            0% { transform: scale(3) rotate(10deg); opacity: 0; }
            100% { transform: scale(1) rotate(-10deg); opacity: 1; }
        }

        .stamp-classified {
            border: 2px dashed #f59e0b;
            color: #f59e0b;
            font-weight: 800;
            padding: 1px 6px;
            border-radius: 4px;
            transform: rotate(4deg);
            display: inline-block;
        }

        /* Shake animation for error */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-7px); }
            40%, 80% { transform: translateX(7px); }
        }
        .animate-shake { animation: shake 0.35s ease-in-out; }

        /* Pulse Glow Animation */
        @keyframes pulse-gold {
            0%, 100% { box-shadow: 0 0 12px rgba(245, 158, 11, 0.2); }
            50% { box-shadow: 0 0 22px rgba(245, 158, 11, 0.45); }
        }
        .glow-gold { animation: pulse-gold 3s infinite ease-in-out; }

        /* Touch Keypad Button Active state */
        .keypad-btn:active {
            transform: scale(0.92);
            background-color: #334155;
        }
    </style>
</head>
<body class="text-slate-200 min-h-[100dvh] flex flex-col justify-between selection:bg-amber-500 selection:text-black">

    <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-50 hidden"></canvas>

    <header class="border-b border-amber-500/20 bg-slate-950/90 backdrop-blur-md sticky top-0 z-30 shadow-lg">
        <div class="max-w-7xl mx-auto px-3 py-2.5 sm:px-4 sm:py-3 flex flex-wrap items-center justify-between gap-2 sm:gap-4">
            
            <!-- Logo & Active Detective Name -->
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-md shadow-amber-500/20 ring-1 ring-amber-300/40 shrink-0">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-sm sm:text-base md:text-lg font-extrabold tracking-wider text-amber-400 flex items-center gap-1.5 leading-tight">
                        方程式破案冒險
                        <span id="header-diff-badge" class="bg-amber-500/20 text-amber-300 text-[10px] sm:text-xs px-1.5 py-0.5 rounded border border-amber-500/40 font-mono">初級</span>
                    </h1>
                    <div class="flex items-center gap-1.5 text-[11px] sm:text-xs text-slate-400">
                        <span>偵探：</span>
                        <span id="header-detective-name" class="font-bold text-amber-300 truncate max-w-[100px] sm:max-w-[160px]">偵探 X</span>
                    </div>
                </div>
            </div>

            <!-- Stats HUD (Score, Timer, Leaderboard, Mute, Restart) -->
            <div class="flex items-center gap-1.5 sm:gap-3">
                <!-- Score Counter -->
                <div class="bg-slate-900 border border-slate-800 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg flex items-center gap-1.5 shadow-inner">
                    <span class="text-[10px] sm:text-xs text-slate-400 font-semibold">積分</span>
                    <span id="score-display" class="font-tech text-base sm:text-xl text-amber-400 font-bold tracking-wider">0000</span>
                </div>

                <!-- Timer -->
                <div id="timer-box" class="bg-slate-900 border border-slate-800 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg flex items-center gap-1.5 transition-colors">
                    <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span id="timer-display" class="font-tech text-base sm:text-xl text-cyan-400 font-bold tracking-wider">03:00</span>
                </div>

                <!-- Leaderboard Button -->
                <button id="open-leaderboard-btn" class="min-w-[38px] min-h-[38px] px-2 py-1.5 text-xs font-semibold rounded-lg bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-300 transition-all flex items-center justify-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    <span class="hidden md:inline">榮譽榜</span>
                </button>

                <!-- Sound Mute -->
                <button id="sound-btn" class="min-w-[38px] min-h-[38px] p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-amber-400 transition-all flex items-center justify-center" title="靜音/開音">
                    <svg id="sound-icon-on" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"></path>
                    </svg>
                    <svg id="sound-icon-off" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
                    </svg>
                </button>

                <!-- Restart -->
                <button id="restart-btn" class="min-w-[38px] min-h-[38px] p-2 sm:px-2.5 sm:py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 transition-all flex items-center justify-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    <span class="hidden sm:inline">重置</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-3 py-4 sm:px-4 sm:py-6 flex-grow w-full grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6">

        <!-- LEFT PANEL: Active Case & Math Solving Area (7 Cols) -->
        <section class="lg:col-span-7 flex flex-col gap-4">

            <div class="bg-slate-900/95 border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-2xl relative overflow-hidden backdrop-blur-md">
                
                <!-- Case Metadata Header -->
                <div class="flex items-center justify-between border-b border-slate-800/80 pb-2.5 mb-3.5">
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 mr-1.5 animate-pulse"></span>
                            案件調查中
                        </span>
                        <span id="case-number-badge" class="font-mono text-xs text-slate-400">CASE #01 / 05</span>
                    </div>
                    <div class="text-[11px] sm:text-xs font-mono text-slate-400">
                        代數類型：<span class="text-amber-400 font-bold">ax + b = c</span>
                    </div>
                </div>

                <!-- Case Narrative -->
                <div class="mb-3.5">
                    <h2 id="case-title" class="text-base sm:text-lg md:text-xl font-bold text-slate-100 mb-1.5 flex items-center gap-2">
                        <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <span id="case-title-text">載入案件中...</span>
                    </h2>
                    <p id="case-description" class="text-slate-300 text-xs sm:text-sm leading-relaxed bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
                        請解開下列方程式，求出未知數 x 的正確數值，即可破解嫌犯秘密情報線索！
                    </p>
                </div>

                <!-- Main Target Math Equation Display Box -->
                <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 p-4 sm:p-6 rounded-2xl border border-amber-500/30 text-center my-2 shadow-inner glow-gold">
                    <p class="text-[10px] sm:text-xs text-amber-400/80 font-mono tracking-widest uppercase mb-1">TARGET EQUATION CODE</p>
                    <div id="equation-display" class="font-mono-math text-2xl sm:text-4xl md:text-5xl font-extrabold text-amber-300 tracking-wider py-1">
                        ax + b = c
                    </div>
                </div>

                <!-- Answer Input & Control -->
                <form id="answer-form" class="mt-4 flex flex-col gap-3">
                    <div class="flex items-center gap-2">
                        <div class="relative flex-grow">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-amber-400 font-mono font-bold text-lg">
                                x =
                            </div>
                            <!-- input mode decimal allows OS numpad if soft keyboard used -->
                            <input 
                                type="text" 
                                id="answer-input" 
                                inputmode="decimal"
                                placeholder="點擊輸入數值..." 
                                readonly
                                class="w-full pl-12 pr-10 py-3 bg-slate-950 border-2 border-slate-700 rounded-xl text-xl font-mono text-amber-300 focus:outline-none focus:border-amber-400 transition-all shadow-inner placeholder:text-slate-600 cursor-pointer"
                            >
                            <button 
                                type="button"
                                id="clear-input-btn"
                                class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-500 hover:text-slate-300"
                            >
                                ✕
                            </button>
                        </div>

                        <!-- Keyboard Mode Switcher -->
                        <button 
                            type="button" 
                            id="toggle-keypad-btn"
                            class="px-3 py-3 bg-slate-800 border border-slate-700 text-amber-300 rounded-xl text-xs font-semibold shrink-0 hover:bg-slate-700 active:scale-95 transition-all flex items-center gap-1"
                            title="切換螢幕數字小鍵盤"
                        >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                            <span id="keypad-toggle-text">按鈕鍵盤</span>
                        </button>
                    </div>

                    <!-- On-Screen Virtual Touch Keypad (Optimized for iPad & Mobile) -->
                    <div id="virtual-keypad" class="bg-slate-950 p-3 rounded-2xl border border-slate-800 grid grid-cols-4 gap-2 text-center my-1 shadow-2xl">
                        <button type="button" data-key="1" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">1</button>
                        <button type="button" data-key="2" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">2</button>
                        <button type="button" data-key="3" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">3</button>
                        <button type="button" data-key="BACK" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-red-950/40 border border-red-800/60 text-red-300 font-bold text-sm shadow flex items-center justify-center">⌫</button>

                        <button type="button" data-key="4" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">4</button>
                        <button type="button" data-key="5" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">5</button>
                        <button type="button" data-key="6" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">6</button>
                        <button type="button" data-key="MINUS" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-800 border border-slate-600 text-amber-400 font-bold text-lg shadow">-</button>

                        <button type="button" data-key="7" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">7</button>
                        <button type="button" data-key="8" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">8</button>
                        <button type="button" data-key="9" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">9</button>
                        <button type="button" data-key="CLEAR" class="keypad-btn min-h-[46px] py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 font-bold text-xs shadow">C</button>

                        <button type="button" data-key="0" class="keypad-btn col-span-2 min-h-[46px] py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-lg font-mono font-bold text-slate-200 shadow">0</button>
                        <button type="submit" id="submit-btn" class="col-span-2 min-h-[46px] py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-base shadow-lg shadow-amber-500/20 active:scale-95 transition-all flex items-center justify-center gap-1.5">
                            <span>破譯送出</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-m0 0l-7 7m7-7H3"></path></svg>
                        </button>
                    </div>
                </form>

                <!-- Feedback & Dynamic Step-by-step Hint Box -->
                <div id="feedback-box" class="mt-3 hidden p-3.5 rounded-xl border text-xs sm:text-sm leading-relaxed transition-all"></div>
            </div>

            <!-- Math Guide Tip -->
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-3.5 text-xs text-slate-400 flex items-start gap-2.5">
                <div class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400 shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                    <p class="font-bold text-slate-300 mb-0.5">解題技巧指南：</p>
                    <p>1. <span class="text-amber-300">移項變號</span>：將常數項移至等號另一邊，加號變減號，減號變加號。</p>
                    <p>2. <span class="text-amber-300">同除係數</span>：兩邊同時除以未知數 x 的前置係數 a，即可算出答案。</p>
                </div>
            </div>

        </section>

        <!-- RIGHT PANEL: Evidence Pinboard Wall (5 Cols) -->
        <section class="lg:col-span-5 flex flex-col gap-4">

            <div class="bg-slate-900/95 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-2xl flex flex-col h-full backdrop-blur-md">
                <!-- Board Title -->
                <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-3">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                        </svg>
                        <h3 class="font-bold text-slate-200 text-sm sm:text-base">證物線索展覽牆</h3>
                    </div>
                    <span id="clue-progress-text" class="text-[11px] font-mono text-amber-400 bg-amber-950/60 px-2 py-0.5 rounded-full border border-amber-800/50">
                        0 / 5 線索
                    </span>
                </div>

                <!-- Clues Container Cards -->
                <div id="clues-container" class="space-y-3 flex-grow">
                    <!-- Cards populated dynamically by JS -->
                </div>

                <!-- Suspect Lock Status -->
                <div class="mt-4 p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-slate-900 border-2 border-slate-700 flex items-center justify-center shrink-0 relative overflow-hidden">
                        <svg class="w-7 h-7 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <div id="suspect-silhouette" class="absolute inset-0 bg-slate-950/90 flex items-center justify-center font-mono text-lg font-bold text-amber-400">
                            ?
                        </div>
                    </div>
                    <div>
                        <div id="suspect-status-title" class="text-xs text-amber-400 font-mono font-bold">嫌犯鎖定進度: 0%</div>
                        <div id="suspect-status-desc" class="text-[11px] text-slate-300 mt-0.5 leading-tight">解開線索還原嫌犯特徵與動機</div>
                    </div>
                </div>
            </div>

        </section>

    </main>

    <!-- WELCOME / NAME INPUT MODAL -->
    <div id="name-modal" class="fixed inset-0 bg-slate-950/95 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-slate-900 border-2 border-amber-500/60 rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-2xl relative overflow-hidden glow-gold max-h-[95dvh] overflow-y-auto">
            <div class="text-center mb-5">
                <div class="w-14 h-14 mx-auto mb-2.5 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/40">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 012-2h2a2 2 0 012 2v1m-4 0h4"></path></svg>
